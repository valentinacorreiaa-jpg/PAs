programa
{
    funcao inicio()
    {
        real num1, num2

        escreva("Digite o primeiro número: ")
        leia(num1)

        escreva("Digite o segundo número: ")
        leia(num2)

        escreva("\nSoma: ", num1 + num2)
        escreva("\nSubtração: ", num1 - num2)
        escreva("\nMultiplicação: ", num1 * num2)
        escreva("\nDivisão: ", num1 / num2)
    }
}